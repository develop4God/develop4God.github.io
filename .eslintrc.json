{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "globals": {
    "DevotionalI18n": "readonly",
    "BibleTextFormatter": "readonly",
    "HindiTtsNormalizer": "readonly",
    "DevotionalShare": "readonly",
    "lucide": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.js", "e2e/**/*.js"],
      "env": {
        "node": true
      }
    }
  ]
}
