{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "globals": {
    "DevotionalI18n": "readonly",
    "BibleTextFormatter": "readonly",
    "HindiTtsNormalizer": "readonly",
    "DevotionalShare": "readonly",
    "DevotionalFetch": "readonly",
    "DevotionalNav": "readonly",
    "DevotionalErrorLogger": "readonly",
    "DevotionalProgress": "readonly",
    "DevotionalVersion": "readonly",
    "DevotionalTts": "readonly",
    "DevotionalRenderDom": "readonly",
    "DevotionalSalvationModal": "readonly",
    "DevotionalInstall": "readonly",
    "DevotionalIosHint": "readonly",
    "DevotionalPwaConfig": "readonly",
    "DevotionalSwRegister": "readonly",
    "DevotionalBuild": "readonly",
    "DiscoveryData": "readonly",
    "DiscoveryStore": "readonly",
    "DiscoveryRouter": "readonly",
    "DiscoveryDetailPage": "readonly",
    "DiscoveryDetailDom": "readonly",
    "DiscoveryCopyright": "readonly",
    "DiscoveryNav": "readonly",
    "DiscoveryCards": "readonly",
    "DiscoveryCache": "readonly",
    "DiscoveryListPage": "readonly",
    "DiscoveryListDom": "readonly",
    "DiscoveryCardDom": "readonly",
    "DiscoveryShareText": "readonly",
    "UiToast": "readonly",
    "UiCelebration": "readonly",
    "UiSwipeDrag": "readonly",
    "UiPagerDots": "readonly",
    "ShareOrCopy": "readonly",
    "DomBuilder": "readonly",
    "DevotionalTheme": "readonly",
    "DiscoverySortFilter": "readonly",
    "DevotionalPush": "readonly",
    "DevotionalShell": "readonly",
    "DevotionalShellCore": "readonly",
    "DevotionalPushStore": "readonly",
    "DevotionalPushFirebase": "readonly",
    "DevotionalPushHelp": "readonly",
    "DevotionalPushOffer": "readonly",
    "AppStats": "readonly",
    "RtlHelper": "readonly",
    "SiteFooter": "readonly",
    "WorkWithMeI18n": "readonly",
    "HabitusI18n": "readonly",
    "lucide": "readonly",
    "TerminalMath": "readonly",
    "TerminalScenes": "readonly",
    "TerminalLayout": "readonly",
    "TerminalWorldMask": "readonly",
    "TerminalI18n": "readonly",
    "TerminalLanguageMenu": "readonly",
    "TerminalTheme": "readonly",
    "TerminalCases": "readonly",
    "TerminalCanvas": "readonly",
    "TerminalLogoImage": "readonly",
    "TerminalTwinLife": "readonly",
    "TerminalSpin": "readonly",
    "TerminalGlobe": "readonly",
    "TerminalGlobeLayer": "readonly",
    "TerminalStory": "readonly",
    "TerminalEffects": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.js", "e2e/**/*.js", "scripts/**/*.js"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["devocionales/js/*.js", "devocionales/pwa/*.js"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "AssignmentExpression[left.property.name=/^(innerHTML|outerHTML)$/]",
            "message": "The reader renders remote content: build nodes with createElement/textContent (or DomBuilder in new modules), never innerHTML/outerHTML."
          },
          {
            "selector": "CallExpression[callee.property.name='insertAdjacentHTML']",
            "message": "The reader renders remote content: build nodes with createElement/textContent, never insertAdjacentHTML."
          },
          {
            "selector": "CallExpression[callee.object.name='document'][callee.property.name=/^(write|writeln)$/]",
            "message": "document.write parses its argument as HTML: build nodes with createElement/textContent."
          }
        ]
      }
    },
    {
      "files": ["devocionales/js/i18n.js", "devocionales/js/modern.js"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}
